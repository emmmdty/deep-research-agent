# LLM 配置（MiniMax 为默认 Provider）
LLM_PROVIDER=minimax
LLM_MODEL_NAME=MiniMax-M2.5
LLM_API_KEY=your_minimax_api_key_here
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# 部分 thinking 模型（如 DeepSeek 推理版）会耗尽整个输出预算在推理上并返回空内容；
# 设为 true 会向端点发送 extra_body 关闭 thinking（仅支持该参数的 OpenAI-compatible 端点有效）
LLM_DISABLE_THINKING=false

# 多模态（图像类问题，GAIA 场景）：vision 模型配置；未配置时 read_image 工具不可用
VISION_MODEL_NAME=
VISION_API_KEY=
VISION_BASE_URL=

# 备选：DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL_NAME=deepseek-chat
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 备选：Agicto
# LLM_PROVIDER=agicto
# AGICTO_API_KEY=your_agicto_api_key_here

# 备选：OpenAI / Anthropic / compatible providers
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=your_key_here
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint/v1
# LLM_PROVIDER=anthropic_compatible
# ANTHROPIC_COMPATIBLE_API_KEY=your_key_here
# ANTHROPIC_COMPATIBLE_BASE_URL=https://your-endpoint

# 搜索配置
SEARCH_BACKEND=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# 研究流程配置
MAX_RESEARCH_LOOPS=3
MAX_SEARCH_RESULTS=5
RESEARCH_PROFILE=default
RESEARCH_CONCURRENCY=3
# 列表字段建议使用 JSON 数组，便于 shell / CI / uv run 覆盖
ENABLED_CAPABILITY_TYPES=["builtin","skill","mcp"]
SKILL_PATHS=[]
MCP_CONFIG_PATH=
MCP_SERVERS=[]
SOURCE_POLICY_MODE=open-web
BUNDLE_EMISSION_ENABLED=true
BUNDLE_OUTPUT_DIRNAME=bundles
JOB_RUNTIME_DIRNAME=research_jobs
JOB_HEARTBEAT_INTERVAL_SECONDS=2
JOB_STALE_TIMEOUT_SECONDS=15
LEGACY_CLI_ENABLED=true
CONNECTOR_SUBSTRATE_ENABLED=true
SNAPSHOT_STORE_DIRNAME=snapshots

# Product V2 server profile (required by docker compose; keep secrets out of git)
DATABASE_URL=postgresql+psycopg://deep_research:change-me@postgres:5432/deep_research
# For a local offline run instead, override these two values and keep the database file under workspace:
# PRODUCT_DATABASE_URL=sqlite+pysqlite:///./workspace/product.db
# PRODUCT_OFFLINE_MODE=true
POSTGRES_DB=deep_research
POSTGRES_USER=deep_research
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=research
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=research-artifacts
DEEP_RESEARCH_AGENT_MASTER_KEY=replace-with-base64-encoded-32-byte-key
DEEP_RESEARCH_AGENT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
DEEP_RESEARCH_AGENT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# Explicit scheduler mode. `offline` is deterministic and credential-free for a demo;
# `production` runs the built-in model-driven agent composition (LLM planner,
# governed web/GitHub/arXiv search, LLM researcher/critic workers) and requires
# LLM credentials above. Override SCHEDULER_FACTORY_PATH to swap in a custom factory.
SCHEDULER_RUNTIME_MODE=offline
SCHEDULER_FACTORY_PATH=deep_research_agent.agents.factory:build_scheduler_factory
# Use the LLM planner (model generates research sub-objectives) when credentials
# are configured; deterministic planning remains the reproducible fallback.
AGENT_PLANNER_ENABLED=true
# Empty keeps the web client same-origin behind the compose reverse proxy.
VITE_DRA_API_BASE_URL=
GROBID_URL=http://grobid:8070
OTEL_SERVICE_NAME=deep-research-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
CASE_STUDY_OFFICIAL_DOMAINS=["openai.com","anthropic.com","langchain.com","microsoft.com","learn.microsoft.com","aws.amazon.com","cloud.google.com","salesforce.com","ibm.com","huggingface.co"]
ENABLED_SOURCES=["web","github","arxiv"]
ENABLED_COMPARATORS=["ours_v2","gptr","odr"]
JUDGE_MODEL=
WORKSPACE_DIR=workspace
MEMORY_BACKEND=sqlite
GPT_RESEARCHER_PYTHON=

# 外部 comparator（按需启用）
OPEN_DEEP_RESEARCH_COMMAND=
OPEN_DEEP_RESEARCH_REPORT_DIR=
ALIBABA_RUNNER_MODE=command
ALIBABA_COMMAND=
ALIBABA_REPORT_DIR=
GEMINI_ENABLED=false
GEMINI_ALLOWLIST_REQUIRED=true
GEMINI_COMMAND=
GEMINI_REPORT_DIR=

# 日志
LOG_LEVEL=INFO
